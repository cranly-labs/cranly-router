# =============================================================================
# TokenRouter - Coolify environment template
# =============================================================================
# Copy the values you need into the Coolify UI under the resource's
# Environment Variables tab. Coolify injects them into the containers at
# deploy time; this file is a reference, not a file that is read at runtime.
#
# Generate every secret with a fresh command. Never reuse a value across
# environments and never commit a filled-in copy of this file.
#
#   POSTGRES_PASSWORD      openssl rand -hex 32
#   JWT_SECRET             openssl rand -hex 32
#   TOTP_ENCRYPTION_KEY    openssl rand -hex 32
#   REDIS_PASSWORD         openssl rand -hex 32
#   ADMIN_PASSWORD         openssl rand -base64 24
# =============================================================================

# -----------------------------------------------------------------------------
# Core server
# -----------------------------------------------------------------------------
# Image to deploy. Pin a release tag or digest in production; avoid latest.
TOKENROUTER_IMAGE=ghcr.io/cranly-labs/cranly-router:latest

# Public FQDN managed by Coolify. Set the domain in the resource UI and Coolify
# fills this in automatically. Listed here for completeness only.
# SERVICE_FQDN_TOKENROUTER_8080=https://tokenrouter.example.com

# Container timezone for log timestamps and scheduled tasks.
TZ=UTC

# Server mode and bind settings. Keep SERVER_MODE=release in production.
SERVER_MODE=release
SERVER_PORT=8080

# Go runtime soft memory limit. Keep it below TOKENROUTER_MEM_LIMIT so the
# runtime collects garbage before the kernel OOM killer acts.
GOMEMLIMIT=3GiB

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=tokenrouter
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=tokenrouter

# Application connection pool. Keep the sum across replicas well under the
# server-side POSTGRES_MAX_CONNECTIONS.
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# PostgreSQL server tuning. Raise these together with the instance size.
# POSTGRES_MAX_CONNECTIONS must be at least the total application pool plus
# roughly 20 percent headroom.
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
# Shared memory for parallel queries. Docker defaults to 64 MiB, which is too
# small for large aggregations on the usage tables.
POSTGRES_SHM_SIZE=1gb

# Container memory ceiling for the database service.
POSTGRES_MEM_LIMIT=4g

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis is reachable only on the internal network, but a password is still
# recommended so a future misconfiguration cannot expose an open instance.
# Generate: openssl rand -hex 32
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=256
REDIS_MIN_IDLE_CONNS=16

# Soft memory ceiling. Keep it below REDIS_MEM_LIMIT to leave room for
# persistence buffers and client output buffers.
REDIS_MAXMEMORY=1gb
# noeviction is required: TokenRouter keeps locks, sessions and rate-limit
# state in Redis, and evicting those causes incorrect behavior.
REDIS_MAXMEMORY_POLICY=noeviction
REDIS_MEM_LIMIT=1g

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# Session signing key. A stable value keeps users logged in across restarts and
# redeploys. Changing it invalidates every existing session.
# Generate: openssl rand -hex 32
JWT_SECRET=

JWT_EXPIRE_HOUR=24

# Encryption key for stored TOTP secrets. Required if two-factor auth is used.
# Changing it makes every existing TOTP enrollment unusable.
# Generate: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Admin bootstrap
# -----------------------------------------------------------------------------
# Created automatically on the first start when AUTO_SETUP is enabled.
ADMIN_EMAIL=admin@tokenrouter.local
# Leave empty to generate a random password. It is printed once to the
# container logs at first start: read it with `docker logs` or the Coolify log
# viewer, then change it after the first login.
# Generate: openssl rand -base64 24
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Tuning
# -----------------------------------------------------------------------------
# Container memory ceiling for the application. Size it to your expected peak
# of concurrent streams; each in-flight LLM request holds a connection and a
# request buffer.
TOKENROUTER_MEM_LIMIT=4g

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Levels: debug, info, warn, error. Formats: json, console.
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ENV=production
LOG_SERVICE_NAME=tokenrouter

# Enable the operations monitoring menu and background jobs.
OPS_ENABLED=true

# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------
# Token for GitHub release update checks. Downloads stay anonymous.
UPDATE_GITHUB_TOKEN=
UPDATE_PROXY_URL=

# Outbound proxy for upstream provider calls, when direct access is blocked.
# Supports http, https, socks5 and socks5h schemes.
# Example: socks5://127.0.0.1:1080
# Leave empty for a direct connection.

# Gemini OAuth client for AI Studio mode. Leave empty to use the built-in
# Gemini CLI client, which only supports Code Assist OAuth.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_SCOPES=

# Plugin runtime. Disable to hide the plugins menu and skip plugin processes.
PLUGINS_ENABLED=true
PLUGINS_MAX_RUNNING=20

# URL allowlist. Leave disabled to trust operator-supplied upstream URLs.
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=true
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true
