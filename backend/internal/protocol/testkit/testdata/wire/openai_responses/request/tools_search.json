{
  "model": "gpt-5",
  "max_output_tokens": 512,
  "parallel_tool_calls": true,
  "tools": [
    {
      "type": "tool_search"
    },
    {
      "type": "function",
      "name": "read_file",
      "description": "Read a local file.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "defer_loading": true,
      "strict": false
    }
  ],
  "tool_choice": "auto",
  "input": [
    {
      "type": "message",
      "role": "user",
      "content": [
        {
          "type": "input_text",
          "text": "Find the incident pager tools, check sev1 incidents, then search for slack notification tools and check sev2 incidents."
        }
      ]
    },
    {
      "type": "tool_search_call",
      "id": "tsc_pager_1",
      "call_id": "call_search_1",
      "execution": "client",
      "status": "completed",
      "arguments": {
        "query": "incident pager",
        "limit": 5
      }
    },
    {
      "type": "tool_search_output",
      "id": "tso_pager_1",
      "call_id": "call_search_1",
      "execution": "client",
      "status": "completed",
      "tools": [
        {
          "type": "namespace",
          "name": "pager",
          "description": "Incident paging connector.",
          "tools": [
            {
              "type": "function",
              "name": "list_incidents",
              "description": "List active incidents filtered by severity.",
              "parameters": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string"
                  }
                },
                "required": [
                  "severity"
                ]
              },
              "strict": false
            }
          ]
        }
      ]
    },
    {
      "type": "function_call",
      "id": "fc_inc_1",
      "call_id": "call_inc_1",
      "namespace": "pager",
      "name": "list_incidents",
      "arguments": "{\"severity\":\"sev1\"}"
    },
    {
      "type": "function_call_output",
      "call_id": "call_inc_1",
      "output": "{\"incidents\":[{\"id\":\"INC-402\",\"service\":\"payments\"}]}"
    }
  ]
}
