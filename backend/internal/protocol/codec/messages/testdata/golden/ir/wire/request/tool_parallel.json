            "content": [
              {
                "kind": "text",
                "text": "{\"city\":\"London\",\"temp_c\":12,\"condition\":\"cloudy\"}"
              }
            ]
          }
        },
        {
          "kind": "tool_result",
          "result": {
            "call_id": "call_time_lon_2",
            "content": [
              {
                "kind": "text",
                "text": "{\"timezone\":\"Europe/London\",\"local_time\":\"09:30\"}"
              }
            ]
          }
        }
      ]
    },
    {
      "role": "user",
      "parts": [
        {
          "kind": "text",
          "text": "Now check Tokyo weather and Asia/Tokyo time in parallel."
        }
      ]
