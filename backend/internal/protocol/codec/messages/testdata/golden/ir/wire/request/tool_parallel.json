            "arguments": "{\"city\":\"London\"}"
          }
        },
        {
          "kind": "tool_call",
          "call": {
            "call_id": "call_time_lon_2",
            "tool": {
              "kind": "function",
              "name": "get_time"
            },
            "arguments": "{\"timezone\":\"Europe/London\"}"
          }
        }
      ]
    },
    {
      "role": "tool",
      "parts": [
        {
          "kind": "tool_result",
          "result": {
